# Змінні для docker-compose.yml та сервера (скопіюйте у .env)
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters

# ── Продакшн ─────────────────────────────────────────────────────────────
# Дозволені origin для CORS і сокетів — список через кому. Сюди вписуйте
# адресу фронтенда, інакше браузер відмовиться читати відповіді сервера.
# CLIENT_URL=https://taemaoml-tech.github.io,https://miston.example
# CLIENT_URL=http://localhost:5173

# Ставте true, якщо сервер за reverse-proxy (Render, Railway, Fly, nginx):
# без цього IP у журналі та rate-limit працюватимуть неправильно.
# TRUST_PROXY=true

# Згенерувати JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
