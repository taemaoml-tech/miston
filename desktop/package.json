{
  "name": "miston-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Miston — desktop messenger",
  "author": "Miston",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.miston.desktop",
    "productName": "Miston",
    "asar": false,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "migrations.mjs",
      "package.json",
      "database/**/*",
      "server/**/*",
      "client/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Miston-${version}.exe"
    },
    "portable": {
      "artifactName": "Miston-${version}.exe"
    }
  }
}

