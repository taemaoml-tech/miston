# Змінні клієнта (Vite читає їх із client/.env*). У девелопменті нічого ставити
# не треба: Vite проксіє /api, /uploads і /socket.io на localhost:4000.

# Абсолютний URL продакшн-сервера Miston. Без нього збірка звертається до
# відносного /api, якого на GitHub Pages немає.
VITE_API_URL=https://miston-api.onrender.com/api

# Лише якщо сокет-сервер живеться на іншому домені, ніж API.
# VITE_SOCKET_URL=https://miston-api.onrender.com

# Базовий шлях збірки. Для GitHub Pages це /<ім'я-репозиторію>/ за замовчуванням.
VITE_BASE_PATH=/miston/
