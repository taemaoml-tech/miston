NODE_ENV=development
DATABASE_URL=postgresql://relay:change-me@localhost:5432/relay
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
PORT=4000
CLIENT_URL=http://localhost:5173
# Для публічного запуску обов'язково додайте origin фронтенда, наприклад:
# CLIENT_URL=http://localhost:5173,https://taemaoml-tech.github.io
UPLOAD_DIR=uploads
MAX_FILE_SIZE=26214400
# Окремий ліміт для файлів власних стікерів (PNG/WebP/GIF), типово 1 МіБ
MAX_STICKER_SIZE=1048576
TRUST_PROXY=false
# TLS до PostgreSQL: auto — як у URL (sslmode=require), require — TLS без перевірки
# сертифіката (Render, Neon), verify — TLS із перевіркою, disable — без TLS.
# На Render рядок підключення приходить без sslmode, тому там потрібен require.
DB_SSL=auto

# WebRTC: STUN працює для більшості мереж; TURN потрібен за симетричного NAT/фаєрвола
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
CALL_RING_TIMEOUT_MS=45000
MAX_CALL_PARTICIPANTS=6
